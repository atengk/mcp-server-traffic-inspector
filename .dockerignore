# ==============================================================================
# Docker 构建上下文忽略清单
# 避免将本地缓存、构建中间产物、抓包文件及机密信息发送到 Docker 守护进程
# ==============================================================================

# 版本控制、CI 与本地工程脚本
.git
.github
.githooks
scripts
.cliff.toml
.gitignore
.dockerignore
tests

# 操作系统、IDE 与临时目录
.DS_Store
Thumbs.db
.idea
.vscode
tmp
temp
.tmp
.temp
*.tmp
*.temp
scratch
.scratch
scratchpad
.scratchpad
sandbox
.sandbox

# 测试覆盖率与代码分析缓存
coverage
*.lcov
.coverage
.coverage.*
htmlcov
.pytest_cache
.ruff_cache
.mypy_cache

# 敏感文件与本地环境变量
.env
.env.*
!.env.example

# 日志与抓包产物
*.log
logs
*.pcap
*.pcapng
*.har
*.db
*.db-wal
*.db-shm

# Python 构建与虚拟环境
__pycache__
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
env/
venv/
.venv/
